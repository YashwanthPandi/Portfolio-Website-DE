source 'https://rubygems.org'

group :jekyll_plugins do
  # Using ~> allows minor updates/patches but prevents major breaking changes
  gem 'jekyll', '~> 4.3' 
  gem 'jekyll-feed', '~> 0.17'
  gem 'jekyll-sitemap', '~> 1.4'
  gem 'jekyll-redirect-from', '~> 0.16'
  gem 'jemoji', '~> 0.13'
  gem 'jekyll-admin', '~> 0.11'
  gem 'webrick', '~> 1.8'
end

# github-pages manages its own dependencies, but locking it is still safer
gem 'github-pages', '~> 231' 

# This one is already strictly locked—keep it that way if your code requires it
gem 'connection_pool', '2.5.0'